# Dirección pública de quien despliega (referencia).
PUBLIC_KEY=
# Llave de quien despliega. Nunca subir el .env real.
PRIVATE_KEY=
RPC_URL=

# --- WillFolksEscrow (fase 1) ---
# USDC de la red destino. Confirmar la dirección en la documentación de Circle antes de usarla.
USDC_ADDRESS=
# Dirección que firma los veredictos (el backend atestador).
ESCROW_ATTESTOR=
# Opcionales. Por defecto: owner = quien despliega, tope de 25 USDC, gracia de 7 días.
ESCROW_OWNER=
ESCROW_MAX_STAKE=
ESCROW_RESOLUTION_GRACE=

# --- WillFolksSingleton (diseño original, no desplegar) ---
AAVE_POOL_ADDRESS=
A_TOKEN_ADDRESS=
DEVELOPER_WALLET=

# RPC local (Anvil) opcional
LOCAL_RPC_URL=http://127.0.0.1:8545
